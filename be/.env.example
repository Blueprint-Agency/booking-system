# ReserveToday backend env. [required] must be set; the rest can stay blank.

# ---- App ---------------------------------------------------------------------
NODE_ENV=development
# Deployment name (development | staging | production), unlike NODE_ENV which stays "production" on any server.
APP_ENV=development
PORT=4000
# Pino level (fatal | error | warn | info | debug | trace | silent). Blank = info when NODE_ENV=production, debug otherwise.
LOG_LEVEL=

# ---- Database [required] -----------------------------------------------------
# Local docker Postgres; the connection strings are built from these in src/db/url.ts.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reservetoday
POSTGRES_PORT=5433
# Password for the non-owner `booking_app` role the server runs as (so RLS applies); required on servers.
DB_APP_PASSWORD=
# Overrides: DATABASE_URL = owner (migrations + seeds), DATABASE_APP_URL = the app's `booking_app` role.
# DATABASE_URL=
# DATABASE_APP_URL=

# ---- Super portal [optional] -------------------------------------------------
# Comma-separated super portal admins, seeded passwordless into the platform pool; blank = nobody gets in.
PLATFORM_ADMIN_EMAIL=admin@reservetoday.app

# ---- Origins [required] ------------------------------------------------------
# Frontend URLs; `*` = tenant slug and is required (no `*` = no working studio links). Also the CORS/auth allowlist; the first wildcard per app is the base of mailed links, so keep these first.
FRONTEND_URLS=http://*.localhost:3000,http://*.portal.localhost:3001,http://localhost:3000,http://localhost:3001

# ---- Better Auth [required] --------------------------------------------------
# Signs sessions for all three pools, ≥32 chars; rotating signs everyone out. node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=
# The backend's public origin, the base of every auth link it mails.
BETTER_AUTH_URL=http://localhost:4000

# ---- Impersonation grant signing [required] ----------------------------------
# HS256 secret for superadmin-impersonation grants, ≥32 chars (generate as above).
IMPERSONATION_SECRET=

# ---- Mail (Resend) [required] -----------------------------------------------
# Resend API key with sending access to the verified domain.
RESEND_API_KEY=
# Signing secret (whsec_…) of the Resend webhook pointed at /api/v1/webhooks/resend. Blank: that route answers "not configured".
RESEND_WEBHOOK_SECRET=
# The sender (noreply@reservetoday.app, "ReserveToday") is a constant in src/lib/mailer.ts, not env.

# ---- Stripe ------------------------------------------------------------------
# A stand-in for Stripe's API, as an origin. Blank = Stripe itself. The browser journeys
# set it to the e2e package's Stripe stub (http://127.0.0.1:12111) when they boot the
# local stack; production refuses it at boot.
STRIPE_API_URL=
# Every studio takes payments on its OWN Stripe account (#100, #293); there is
# no platform account key here. A studio's secret key and signing secret are
# entered in the super portal and stored encrypted with this key, so a database
# backup is not a set of live payment keys. Base64, exactly 32 bytes:
#     openssl rand -base64 32
# Required wherever payments are expected. Leave blank only locally, where no
# studio takes a payment: the super portal then refuses to save credentials
# rather than storing them in the clear, and every studio's checkout is refused
# as `payments_not_configured`. Rotating this orphans every stored credential:
# each studio's has to be re-entered.
PAYMENT_CREDENTIALS_KEY=

# ---- Cloudflare R2 -----------------------------------------------------------
# One public bucket shared by staging and production behind https://cdn.reservetoday.app (see cdn/README.md).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ---- Tests (local only) ------------------------------------------------------
# Scratch DB the test harness wipes; never a real one. `npm run test:db` creates one for this checkout
# (reservetoday-test-<checkout folder>) and fills this in. e.g. postgres://postgres:postgres@localhost:5433/reservetoday-test-main
TEST_DATABASE_URL=

# ---- Mindbody migration tooling (operator's machine only) --------------------
# Read by `npm run mindbody:download` / `npm run mindbody` (be/tools/mindbody), never by the server,
# so not in src/env.ts or the deploy. See docs/md/mindbody-import.md.
# The private folder outside the repo that holds the exports (one <YYYY-MM-DD HHmm>/ per download),
# the studio's answers and its Mindbody sign-in. e.g. C:\Users\<you>\mindbody-export
MB_EXPORT_ROOT=
# The studio's Mindbody sign-in (MB_STUDIO/MB_EMAIL/MB_PASSWORD) and saved session. Blank = in MB_EXPORT_ROOT.
MB_LOGIN_FILE=
MB_AUTH_FILE=
# History cutoff the download starts from (YYYY-MM-DD); blank = 2023-01-01. On or before the config's history.from.
MB_START=
# The studio's timezone (e.g. Asia/Singapore). The download writes its as-of moment on this clock,
# whatever this machine's timezone is. Required for a download.
MB_TIMEZONE=
# Blank = defaults: 10 minutes per request, 6 date pieces at a time.
MB_TIMEOUT=
MB_PARALLEL=
