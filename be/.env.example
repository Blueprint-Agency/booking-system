# =============================================================================
# Yoga Sadhana — Backend env
# =============================================================================
# Required keys for v0 (admin portal) are flagged [required].
# Deferred keys can be left blank until the corresponding slice ships.

# ---- App ---------------------------------------------------------------------
NODE_ENV=development
# Deployment environment NAME (development | staging | production). Separate from
# NODE_ENV, which stays "production" on any server. Drives the Sentry environment
# tag and whether Sentry reports at all (off when development).
APP_ENV=development
PORT=4000
# Background cron jobs (src/jobs/index.ts) — PT request expiry + credit auto-refund,
# package expiry, waiver flagging. Off means members' credits are never returned.
ENABLE_JOBS=true

# ---- Database [required] -----------------------------------------------------
# Compose docker postgres locally — these four feed both docker-compose and
# the connection string, which is assembled in src/db/url.ts.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=yoga-sadhana
POSTGRES_PORT=5433
# Password for the `booking_app` role — the NON-owner, non-superuser role the
# server connects as. It matters because Postgres lets superusers and table
# owners bypass Row-Level Security: connect as POSTGRES_USER above and the
# tenant policies (migration 0033) stop enforcing anything, silently.
#
# `npm run db:migrate` creates the role with exactly this password, and
# src/db/url.ts builds DATABASE_APP_URL from it, so the two cannot drift. Local
# dev can leave it blank (a dev-only default is used); on a server it is the
# DB_APP_PASSWORD environment secret and is required — unset, the migrate step
# refuses rather than provisioning a role nothing knows the password to.
DB_APP_PASSWORD=
# The two connection strings, both assembled from the parts above and both
# overridable. DATABASE_URL is the owner (migrations + seeds); DATABASE_APP_URL
# is the `booking_app` role the server runs as. Deployments set both explicitly.
# DATABASE_URL=
# DATABASE_APP_URL=

# ---- Superadmin bootstrap [required] -----------------------------------------
# Passwordless bootstrap. The seed (db/seed/superadmin.ts) creates a Clerk user
# with this email — no password is stored anywhere. On first sign-in the operator
# clicks "Forgot password" and Clerk emails them a reset link to set their own
# password. Re-running the seed never touches an existing Clerk user's credential
# (so subsequent deploys don't lock them out).
SUPERADMIN_EMAIL=

# ---- CORS [required] ---------------------------------------------------------
# fe-portal origin — used for CORS allowlist and as the base for invitation
# sign-up URLs in outgoing emails. For CORS-only wildcard matching, this may be
# a leading-wildcard origin such as https://*.vercel.app.
PORTAL_ORIGIN=http://localhost:3001
# fe-client origin — added to the CORS allowlist when set. Leave blank to keep
# the BE locked to fe-portal only. For CORS-only wildcard matching, this may be
# a leading-wildcard origin such as https://*.vercel.app.
CLIENT_ORIGIN=http://localhost:3000

# ---- Clerk: staff app [required] ---------------------------------------------
# Single Clerk application backing fe-portal (admin + instructor roles).
CLERK_STAFF_PUBLISHABLE_KEY=
CLERK_STAFF_SECRET_KEY=
CLERK_STAFF_WEBHOOK_SECRET=
# Optional: comma-separated origins the JWT must be authorised for.
# Leave blank for local dev. Set to "https://your-portal.example.com" in prod.
CLERK_STAFF_AUTHORIZED_PARTIES=

# ---- Impersonation grant signing [required] ----------------------------------
# HS256 secret for the BE-signed JWT that proves a /api/v1/me/* call is being
# made by a superadmin impersonating a client. Must be at least 32 chars.
# Generate locally with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
IMPERSONATION_SECRET=

# ---- SMTP [required] ---------------------------------------------------------
# Only credentials are env-driven. Host/port/secure/from are hardcoded in
# be/src/lib/mailer.ts (Gmail SMTP, smtp.gmail.com:587, "Yoga Sadhana <…>").
# For Gmail: enable 2FA, then generate an App Password — that's what goes here
# (NOT your account password).
SMTP_USER=
SMTP_PASSWORD=

# =============================================================================
# DEFERRED — fill when the corresponding slice lands
# =============================================================================

# ---- Clerk: client app (deferred) --------------------------------------------
# Second Clerk application backing fe-client (member-facing). Separate user
# pool from the staff app. Cross-app tokens are rejected by the middleware.
CLERK_CLIENT_PUBLISHABLE_KEY=
CLERK_CLIENT_SECRET_KEY=
CLERK_CLIENT_WEBHOOK_SECRET=

# ---- Stripe (deferred — payments slice) --------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Cloudflare R2 -----------------------------------------------------------
# S3-compatible object storage. ONE bucket holds everything: instructor and
# workshop imagery AND leave Supporting Documents. It is served by R2_PUBLIC_URL, so
# every object in it is readable by anyone holding the key.
# Leave R2_BUCKET_NAME blank and document upload reports itself unavailable
# (boot is fine).
#
# R2_PUBLIC_URL is the CDN hostname, never the bucket's own pub-<hash>.r2.dev
# URL — Cloudflare rate-limits that one and does not intend it for production.
# Use https://cdn.reservetoday.app (prod) or https://cdn.staging.reservetoday.app
# (staging); both are served by the `cdn/` Vercel project, which keeps r2.dev as
# a private origin. See cdn/README.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ---- Tests (local only) ------------------------------------------------------
# Scratch Postgres database for the integration tests. Deliberately NOT in
# src/env.ts and not in deploy-be.yml: the running app never reads it, only the
# test harness does. Unset → the integration tests skip. The harness migrates
# and writes to whatever this points at, so never point it at a real database.
# e.g. postgres://postgres:postgres@localhost:5433/yoga-sadhana-test
TEST_DATABASE_URL=

# ---- Error monitoring (optional) ---------------------------------------------
# Set to your Sentry project DSN to turn on backend error reporting. Leave blank
# to disable — the app runs identically without it (see src/instrument.ts).
SENTRY_DSN=
