# =============================================================================
# Yoga Sadhana — Backend env
# =============================================================================
# Required keys for v0 (admin portal) are flagged [required].
# Deferred keys can be left blank until the corresponding slice ships.

# ---- App ---------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# ---- Database [required] -----------------------------------------------------
# Compose docker postgres locally — these four feed both docker-compose and
# the DATABASE_URL below.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=yoga-sadhana
POSTGRES_PORT=5433
DATABASE_URL=postgres://postgres:postgres@localhost:5433/yoga-sadhana

# ---- Superadmin bootstrap [required] -----------------------------------------
# Email seeded into staff_users with role=superadmin, status=pending.
# When this email signs into Clerk for the first time, the webhook (or the
# auto-link middleware fallback) links clerk_user_id and flips status=active.
# Never put a password here — Clerk owns identity.
SUPERADMIN_EMAIL=

# ---- CORS [required] ---------------------------------------------------------
# fe-portal origin — used for CORS allowlist and as the base for invitation
# sign-up URLs in outgoing emails.
PORTAL_ORIGIN=http://localhost:3001

# ---- Clerk: staff app [required] ---------------------------------------------
# Single Clerk application backing fe-portal (admin + instructor roles).
CLERK_STAFF_PUBLISHABLE_KEY=
CLERK_STAFF_SECRET_KEY=
CLERK_STAFF_WEBHOOK_SECRET=
# Optional: comma-separated origins the JWT must be authorised for.
# Leave blank for local dev. Set to "https://your-portal.example.com" in prod.
CLERK_STAFF_AUTHORIZED_PARTIES=

# ---- SMTP [required] ---------------------------------------------------------
# Only credentials are env-driven. Host/port/secure/from are hardcoded in
# be/src/lib/mailer.ts (Gmail SMTP, smtp.gmail.com:587, "Yoga Sadhana <…>").
# For Gmail: enable 2FA, then generate an App Password — that's what goes here
# (NOT your account password).
SMTP_USER=
SMTP_PASSWORD=

# =============================================================================
# DEFERRED — fill when the corresponding slice lands
# =============================================================================

# ---- Clerk: client app (deferred) --------------------------------------------
# Second Clerk application backing fe-client (member-facing). Separate user
# pool from the staff app. Cross-app tokens are rejected by the middleware.
CLERK_CLIENT_PUBLISHABLE_KEY=
CLERK_CLIENT_SECRET_KEY=
CLERK_CLIENT_WEBHOOK_SECRET=

# ---- Stripe (deferred — payments slice) --------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Cloudflare R2 (deferred — photo uploads slice) --------------------------
# S3-compatible object storage for instructor + workshop cover images.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
