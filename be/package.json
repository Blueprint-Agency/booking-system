{
  "name": "reservetoday-be",
  "version": "1.0.0",
  "description": "ReserveToday multi-tenant booking platform backend",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit",
    "check": "node --import tsx --test \"src/**/*.test.ts\"",
    "start": "tsx src/server.ts",
    "predb:generate": "tsx src/db/migrations/check-journal.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed/run.ts",
    "e2e:studio": "tsx src/e2e/cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@hono/node-server": "^1.19.17",
    "@hono/zod-validator": "^0.4.0",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.4",
    "dotenv": "^16.0.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "hono-rate-limiter": "^0.4.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.0",
    "qrcode": "^1.5.3",
    "resend": "^6.28.0",
    "stripe": "^14.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
