# =============================================================================
# ReserveToday — fe-client env (Next.js)
# =============================================================================

# ---- Backend [required] ------------------------------------------------------
# Where this fe-client calls for /api/v1/me/* and /api/v1/public/* — must match
# where the `be` server is listening (default 4000 in be/.env).
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Tenant resolution [required] --------------------------------------------
# Everything after the tenant slug. The slug is the hostname minus this suffix,
# and that is the ONLY rule — local, staging and production differ solely in
# this value, so a Host-parsing bug cannot appear in production alone.
#
#   local        localhost:3000        -> acme.localhost:3000
#   staging      dev.reservetoday.app  -> acme.dev.reservetoday.app
#   production   reservetoday.app      -> acme.reservetoday.app
#
# `*.localhost` resolves to loopback in Chrome, Edge and Firefox with no
# hosts-file entry. Being a NEXT_PUBLIC_* var, it must ALSO be set in the Vercel
# dashboard (Production and Preview) — see docs/md/deployment.md.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# ---- Clerk: client app [required] --------------------------------------------
# These are the SAME values you set on the backend's CLERK_CLIENT_* keys —
# one Clerk application is shared between fe-client and `be`. This is a
# SEPARATE Clerk app from fe-portal's staff app; cross-app tokens are rejected
# by the BE middleware.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Note: Clerk routing URLs (sign-in / sign-up / redirects) are HARDCODED as
# props on <ClerkProvider> in src/app/layout.tsx — they don't belong in env
# because they're tied to this codebase's route structure.

# ---- Stripe (deferred — payments slice) --------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---- Error monitoring (optional) ---------------------------------------------
# Set in Vercel Preview/Production to enable Sentry in deployed builds.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SENTRY_DSN=
