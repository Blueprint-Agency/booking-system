# =============================================================================
# Yoga Sadhana — fe-client env (Next.js)
# =============================================================================

# ---- Backend [required] ------------------------------------------------------
# Where this fe-client calls for /api/v1/me/* and /api/v1/public/* — must match
# where the `be` server is listening (default 4000 in be/.env).
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Clerk: client app [required] --------------------------------------------
# These are the SAME values you set on the backend's CLERK_CLIENT_* keys —
# one Clerk application is shared between fe-client and `be`. This is a
# SEPARATE Clerk app from fe-portal's staff app; cross-app tokens are rejected
# by the BE middleware.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ---- Clerk routing -----------------------------------------------------------
# This client app's auth routes live at /login and /register (see
# src/app/(client)/login and /register). Fallback redirect after sign-in/up
# goes back to the homepage.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
